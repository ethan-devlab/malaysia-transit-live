# Copy to .env.local. Values stay on this computer and are never committed.
# POSTGRES_PASSWORD must contain only URL-safe letters, numbers, underscores, or hyphens.
POSTGRES_DB=malaysia_transit
POSTGRES_USER=transit
POSTGRES_PASSWORD=replace-with-a-long-url-safe-local-password
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_LOCAL_ONLY=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TRANSIT_ARCHIVE_BACKEND=filesystem
TRANSIT_ARCHIVE_DIRECTORY=/var/lib/transit/archives
VITE_MAPTILER_KEY=replace-with-your-localhost-restricted-maptiler-key
