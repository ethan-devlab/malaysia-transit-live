# Required application boundary
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-railway-public-domain.up.railway.app
WORKER_ORIGIN_SECRET=replace-with-a-long-random-edge-secret

# Railway managed services
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
REDIS_URL=redis://default:password@host:port/0

# Cloudflare R2 private archive bucket
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_GTFS_ARCHIVE_BUCKET=malaysia-transit-gtfs-archive
